---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="footer dark">
  <div class="wrap footer__grid">
    <div>
      <div class="footer__brand">Veronica Quiñones <span>22</span></div>
      <p class="muted" data-i18n="footer.tag">Concept campaign for 22nd Ward Alderperson. Little Village / La Villita, Chicago.</p>
      <p class="foot" data-i18n="footer.dates">Election: February 23, 2027 · Runoff: April 6, 2027</p>
    </div>
    <div>
      <h4 data-i18n="footer.explore">Explore</h4>
      <ul>
        <li><a href={`${base}/meet/`} data-i18n="nav.meet">Meet Veronica</a></li>
        <li><a href={`${base}/platform/`} data-i18n="nav.platform">Platform</a></li>
        <li><a href={`${base}/join/`} data-i18n="nav.join">Get involved</a></li>
      </ul>
    </div>
    <div>
      <h4 data-i18n="footer.note_h">A note on this site</h4>
      <p class="foot" data-i18n="footer.note">This is an internal brainstorm to visualize what a campaign could look like. Nothing here is a declaration of candidacy. All figures and dates should be verified before any public use. Latina Sweat Project is a 501(c)(3) and is not affiliated with any campaign.</p>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <span class="foot">© 2026 · Draft · <span data-i18n="footer.built">Built as a working prototype</span></span>
  </div>
</footer>

<style>
  .footer { padding: 56px 0 28px; }
  .footer__grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .footer__brand { font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; margin-bottom: 10px; }
  .footer__brand span { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--rose); color: #fff; font-size: 0.9rem; margin-left: 8px; vertical-align: middle; }
  .footer h4 { font-size: 0.85rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .footer ul a { color: rgba(255,255,255,0.8); text-decoration: none; }
  .footer ul a:hover { color: var(--gold); }
  .footer__bottom { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line-light); }
</style>
