---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Veronica Quiñones for 22nd Ward — Exploratory Campaign',
  description = 'An exploratory campaign site for Veronica Quiñones, co-founder of the Latina Sweat Project and a lifelong Little Village resident, considering a 2027 run for Chicago 22nd Ward alderperson (Little Village). Election day: February 23, 2027.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/images/og-card.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Exploratory / brainstorm site: keep out of search indexes until a launch decision -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Veronica Quiñones for 22nd Ward" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body data-base={base}>
    <div class="draft-bar" data-i18n="draft.bar">Concept site. Not an announcement. An internal brainstorm for a potential 2027 campaign.</div>
    <Navbar />
    <slot />
    <Footer />
    <script>
      import { initI18n } from '../i18n/i18n.js';
      import { initMotion } from '../scripts/motion.js';
      document.addEventListener('DOMContentLoaded', () => {
        initI18n();
        initMotion();
      });
    </script>
  </body>
</html>
